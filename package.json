{
  "name": "@codedang/browser-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/browser-runner.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:java": "node scripts/build-java-bridge.mjs",
    "prepare:toolchains": "node scripts/prepare-runno-toolchains.mjs",
    "test:toolchains": "node --test scripts/prepare-runno-toolchains.test.mjs",
    "predev:playground": "npm run prepare:toolchains",
    "dev:playground": "vite --config playground/vite.config.ts",
    "check:playground": "tsc -p playground/tsconfig.json",
    "prebuild:playground": "npm run prepare:toolchains",
    "build:playground": "npm run check:playground && vite build --config playground/vite.config.ts",
    "test:playground": "playwright test --config playground/playwright.config.ts",
    "check": "tsc --noEmit",
    "prebuild": "npm run prepare:toolchains",
    "build": "npm run check && vite build && tsc --emitDeclarationOnly",
    "test": "vitest run && npm run test:toolchains",
    "test:browser": "npm run build && playwright test"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@runno/sandbox": "0.10.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.539.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^2.1.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^6.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@obsidize/tar-browserify": "^3.0.2",
    "@runno/wasi": "0.10.0",
    "pako": "^1.0.11"
  }
}
